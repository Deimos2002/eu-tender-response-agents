# Copy to .env and fill in. Never commit .env.
# Agent model (M1+): OpenAI gpt-5-mini by default
OPENAI_API_KEY=
TW_PROVIDER=openai
TW_MODEL=gpt-5-mini
# minimal | low | medium: reasoning tokens are billed as output
TW_REASONING_EFFORT=low
MISTRAL_API_KEY=
GROQ_API_KEY=
# Project A (compliance copilot); defaults to the deployed Azure URL
COMPLIANCE_API_URL=
# Bearer token for `python -m tw.mcp_servers.http` (read-only servers over HTTP, e.g. for Dify); >= 32 chars
MCP_HTTP_TOKEN=
# Public host name(s) when the HTTP servers sit behind a tunnel or proxy, comma-separated
MCP_ALLOWED_HOSTS=
# Secret for human approval tokens; if empty, a random key is created in .cache/approval.key
TW_APPROVAL_SECRET=
